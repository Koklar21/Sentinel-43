# =============================================================================
# Sentinel-43 Docker Ignore
# Keeps Docker build context clean and prevents secrets/local junk from being
# sent to the Docker daemon during docker compose build.
# =============================================================================

# -----------------------------------------------------------------------------
# Version Control
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes

# -----------------------------------------------------------------------------
# Python Build, Cache, Test, and Virtual Environments
# -----------------------------------------------------------------------------
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.py[cod]

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

*.egg-info/
dist/
build/

venv/
.venv/
.venv-*/
env/
.env_virt/

# -----------------------------------------------------------------------------
# Test Files and Generated Test Output
# -----------------------------------------------------------------------------
tests/
**/*.xml
**/*.junit

# -----------------------------------------------------------------------------
# Logs, Load Testing, Runtime State, and Local Databases
# -----------------------------------------------------------------------------
logs/
**/*.log
gunicorn.log

loadtest-results/
load_test_results.csv
sequential_marathon_results.log

sentinel43_state/

**/*.sqlite3
**/*.db
**/*.db-wal
**/*.db-shm

# -----------------------------------------------------------------------------
# Secrets, Environment Files, Certificates, and Key Material
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

.secrets/
secrets/

**/*.key
**/*.pem
**/*.cert
**/*.crt
**/*.p12
**/*.pfx
**/*.enc
**/*.gpg

# -----------------------------------------------------------------------------
# Frontend / Node Artifacts
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.parcel-cache/
.next/

# -----------------------------------------------------------------------------
# OS, Editor, and Hidden Backup Files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

.vscode/
.idea/
.fleet/
.history/

**/*.tmp
**/*.bak
**/*.swp
**/.*.swp
**/.*.swo
*~

# -----------------------------------------------------------------------------
# Local Generated Archives
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# -----------------------------------------------------------------------------
# Owner-designated orchestration core (Sentinel-43/).
# Ship the complete owner-designated runtime source set. Shadow_mode.py is the
# live response engine today; Nexus, node/core, and AI-escalation are being
# integrated under Sentinel43RuntimeAuthority and must be present in the image
# when that wiring lands. This packaging change alone does not activate them.
# -----------------------------------------------------------------------------
Sentinel-43/*
!Sentinel-43/Shadow_mode.py
!Sentinel-43/Sentinel_Nexus.py
!Sentinel-43/Sentinel_core.py
!Sentinel-43/sentinel_AI_escalation.py
!Sentinel-43/README.md

# -----------------------------------------------------------------------------
# Local developer tooling (gitignored, machine-local -- CI's fresh checkout
# never has this directory, but a local build on a machine that does would
# otherwise COPY these straight into the image). Found via a local Trivy
# scan surfacing two Windows kind.exe/kubeconform.exe binaries bundled with
# their own outdated Go toolchain, entirely unrelated to the application.
# -----------------------------------------------------------------------------
.tools/

# -----------------------------------------------------------------------------
# Generated acceptance evidence (scripts/acceptance_*.py write here). It is build
# OUTPUT, never an input to the image -- but a checkout that contains it (main
# currently tracks a copy, including a Windows kubeconform.exe with an outdated Go
# toolchain) would otherwise COPY it in, and Trivy then fails the image on that
# binary's stdlib CVEs, none of which are in the application.
# -----------------------------------------------------------------------------
acceptance_out/
