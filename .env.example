# =============================================================================
# Sentinel-43 — Environment Variables
#
# Copy to .env and fill in all CHANGE_ME values before starting.
# Never commit .env to version control.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- Runtime environment -----------------------------------------------------
# Use "production" in prod. Anything in LOCAL_TEST_ENVIRONMENTS bypasses
# some auth guards — never set to development/dev/local/test in production.
SENTINEL_ENV=development
# S43_ENV mirrors SENTINEL_ENV for backward compatibility with s34_auth.py.
# Keep both in sync.
S43_ENV=development

# --- Database ----------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://s43:CHANGE_ME@s43-db:5432/s43

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- JWT authentication ------------------------------------------------------
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
S43_JWT_SECRET=CHANGE_ME
S43_JWT_ALGORITHM=HS256
S43_JWT_ISSUER=sentinel-43
S43_JWT_AUDIENCE=sentinel-43-dashboard

# --- Dashboard operator credentials -------------------------------------------
# Required to log in. Generate the hash with:
#   python scripts/generate_secrets.py --password-hash
S43_OPERATOR_USERNAME=operator
S43_OPERATOR_PASSWORD_HASH=CHANGE_ME

# --- WebSocket auth ----------------------------------------------------------
# true in production. false is acceptable for local dev only.
S43_WS_REQUIRE_AUTH=false

# --- CORS / allowed origins --------------------------------------------------
# Production: set to your actual domain(s), comma-separated.
# Dev default covers Live Server (5500) and FastAPI direct (8000).
S43_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# --- Auth key store pepper ---------------------------------------------------
# Required in production. Must be >= 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Dev environments use an ephemeral random pepper if unset — keys will not
# survive process restarts without this set.
S43_AUTH_PEPPER=CHANGE_ME

# --- Log pseudonymization salt -----------------------------------------------
# Used by Shadow_mode.py / sentinel_ai_escalation.py to hash IPs and
# identities before they hit logs. Required in production — a known salt
# lets anyone precompute hashes of common IPs and de-anonymize log output.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_LOG_SALT=CHANGE_ME

# --- Jormungandr cryptographic audit node ------------------------------------
# S43_JORM_ROOT_KEY: when set, encrypted audit records survive restarts.
# When absent, os.urandom(32) is used — records are unreadable after restart.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
S43_JORM_ENABLED=false
S43_JORM_ROOT_KEY=CHANGE_ME
S43_JORM_MODE=FORENSIC
S43_JORM_RETAIN_EPOCHS=8

# --- SpartaCore integrity watchdog -------------------------------------------
# Required if S43_SPARTA_ENABLED=true. Generate with token_urlsafe(32).
S43_SPARTA_ENABLED=false
S43_SPARTA_TOKEN_SECRET=CHANGE_ME
S43_SPARTA_NODE_TOKEN=CHANGE_ME

# --- Remote gateway operator tokens -------------------------------------------
# Each token maps to a fixed role (owner/admin/auditor) for /remote-gateway/*.
# Routes fail closed (503) if none are configured. Only set the roles you
# actually need to grant remote gateway access.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_REMOTE_TOKEN_OWNER=CHANGE_ME
SENTINEL_REMOTE_TOKEN_ADMIN=CHANGE_ME
SENTINEL_REMOTE_TOKEN_AUDITOR=CHANGE_ME

# --- Feature flags -----------------------------------------------------------
# Never true in production.
S43_ENABLE_TEST_INJECTION=false
S43_GOVERNANCE_ENABLED=false

# =============================================================================
# Fenrir — Threat Hunter
#
# FenrirHunter runs embedded inside the API process (embedded_mode=true).
# It owns a SentinelThreatDetector and a Welford statistical anomaly layer.
# Findings are reported to /watchtower/events and /internal/events/broadcast.
#
# To enable: set S43_FENRIR_ENABLED=true and restart Docker.
# =============================================================================

# Master switch. false = Fenrir does not start at all.
S43_FENRIR_ENABLED=false

# Node identity — shows up in all finding payloads and the /fenrir/status endpoint.
S43_FENRIR_NODE_ID=fenrir-hunter-01

# Embedded mode: true = runs inside the API process, no separate health server.
# false = standalone mode with its own health server on S43_FENRIR_HEALTH_PORT.
# Leave true when running inside Docker Compose with the API container.
S43_FENRIR_EMBEDDED=true

# Health server (standalone mode only — ignored when EMBEDDED=true)
S43_FENRIR_HOST=0.0.0.0
S43_FENRIR_HEALTH_PORT=9201

# --- Hunt loop ---------------------------------------------------------------

# How often Fenrir runs assess_all() and checks for findings. Seconds.
# 2.0 is responsive. 5.0 is lighter on CPU. Don't go below 1.0.
S43_FENRIR_SCAN_INTERVAL=5.0

# How many consecutive hunt loop errors before transitioning to ERROR state.
# Below this threshold: DEGRADED (limping, still ready). At/above: ERROR (hard stop).
S43_FENRIR_MAX_ERRORS=3

# --- Severity threshold ------------------------------------------------------

# Minimum severity to report via Watchtower and dashboard broadcast.
# LOW and MEDIUM are always counted in metrics but not forwarded externally.
# ANOMALY escalations (from the Welford layer) bypass this threshold —
# a statistically anomalous LOW-score event still gets reported.
# Options: LOW | MEDIUM | HIGH | CRITICAL
S43_FENRIR_MIN_SEVERITY=HIGH

# --- Reporting endpoints -----------------------------------------------------

# Where Fenrir POSTs findings to reach Watchtower.
# In Docker Compose this should point to the API container's internal address.
S43_FENRIR_WATCHTOWER_URL=http://s43-api:8000/watchtower/events

# Where Fenrir POSTs to broadcast findings to WebSocket dashboard clients.
# Must match the /internal/events/broadcast route registered in main.py.
S43_FENRIR_BROADCAST_URL=http://s43-api:8000/internal/events/broadcast

# HTTP timeout for outbound reports. Seconds.
# If Watchtower or the broadcast endpoint doesn't respond in this time,
# Fenrir logs a failure, increments the counter, and keeps hunting.
S43_FENRIR_REPORT_TIMEOUT=5.0

# Auth token Fenrir uses when POSTing to API endpoints.
# In development (SENTINEL_ENV=development) the API accepts requests without
# a token via the dev-operator fallback — this can be left blank in dev.
# In production this must be a valid signed JWT with operator or admin role.
# Generate a long-lived service token with generate_env.py or your JWT tooling.
S43_FENRIR_API_TOKEN=

# Log level for the FenrirHunter logger.
S43_FENRIR_LOG_LEVEL=INFO

# --- Detector tuning ---------------------------------------------------------

# Rolling window size for the SentinelThreatDetector. Seconds.
# Events older than this are pruned from each identity's window.
S43_FENRIR_WINDOW_SECONDS=60.0

# Maximum number of (identity, ip) keys the detector tracks simultaneously.
# 0 = no cap (unbounded growth — fine for dev, set a limit for production).
# When the cap is hit, the least-recently-used key is evicted.
S43_FENRIR_MAX_KEYS=0

# Number of worker threads in the dedicated detector thread pool.
# 2 is enough — assess_all() holds a single RLock internally.
S43_FENRIR_POOL_WORKERS=2

# --- Welford anomaly layer tuning --------------------------------------------
#
# The anomaly layer maintains a per-identity statistical baseline using
# Welford's online algorithm. It fires on two independent signals:
#
#   1. Z-score: a single assessment score deviates significantly from the
#      identity's historical average. Catches sudden spikes.
#
#   2. Cumulative pressure: the identity's time-decayed running total
#      exceeds the pressure threshold. Catches slow/sustained activity
#      that never spikes high enough to cross fixed score thresholds.
#
# Both signals fire independently. Either one reports the finding.
# Anomaly findings include detection_method="statistical_anomaly" in the
# payload so operators can distinguish them from threshold findings.

# Z-score threshold above which a score is considered anomalous.
# 3.5 = flags scores more than 3.5 standard deviations above the baseline.
# Lower = more sensitive (more noise). Higher = less sensitive (fewer fires).
S43_FENRIR_ANOMALY_ZSCORE=3.5

# Cumulative pressure threshold. Scores accumulate with exponential decay.
# When the running total exceeds this, the pressure signal fires.
# 150.0 = roughly 3 HIGH-severity windows in a short period, decayed.
S43_FENRIR_ANOMALY_PRESSURE=150.0

# Per-second exponential decay rate for cumulative pressure.
# 0.002 ≈ half-life of ~5.8 minutes (ln(2) / 0.002 / 60).
# 0.001 ≈ half-life of ~11.5 minutes.
# Lower values = slower decay = longer memory of past threat activity.
S43_FENRIR_ANOMALY_DECAY=0.002

# Minimum number of prior observations before the z-score signal is trusted.
# The suspicious score being evaluated doesn't count toward this.
# Prevents false fires during the first few scans of a new identity.
S43_FENRIR_ANOMALY_MIN_OBS=5

# Maximum number of (identity, ip) keys the anomaly layer tracks.
# When the cap is hit, the least-recently-used key is evicted.
S43_FENRIR_ANOMALY_MAX_KEYS=10000

# How long (seconds) before an idle identity's anomaly baseline is pruned.
# 3600 = 1 hour of silence before the key is removed.
S43_FENRIR_ANOMALY_STALE=3600.0

# How many scan cycles between anomaly layer prune passes.
# 300 scans × 5 second interval = prune every ~25 minutes by default.
S43_FENRIR_PRUNE_INTERVAL=300
