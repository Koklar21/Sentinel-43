# =============================================================================

# Sentinel-43 — Environment Variables Example

#

# Copy to .env and fill in all CHANGE_ME values before starting.

# Never commit .env to version control.

#

# Generate secrets:

# python -c "import secrets; print(secrets.token_urlsafe(32))"

# =============================================================================

# --- Runtime environment -----------------------------------------------------

# Production deployments MUST use "production".

SENTINEL_ENV=production

# --- Database ----------------------------------------------------------------

POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://s43:CHANGE_ME_GENERATE_STRONG_RANDOM_PASSWORD@s43-db:5432/s43

# --- Redis -------------------------------------------------------------------

REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM_PASSWORD

# --- JWT authentication ------------------------------------------------------

# Required in production. Minimum 32 bytes recommended.

S43_JWT_SECRET=CHANGE_ME_GENERATE_TOKEN_URLSAFE_32
S43_JWT_ALGORITHM=HS256
S43_JWT_ISSUER=sentinel-43
S43_JWT_AUDIENCE=sentinel-43-dashboard

# --- Auth key-store pepper ---------------------------------------------------

# Required in production. Minimum 32 bytes.

S43_AUTH_PEPPER=CHANGE_ME_GENERATE_TOKEN_HEX_32

# --- WebSocket auth ----------------------------------------------------------

# Must be true in public beta / production.

S43_WS_REQUIRE_AUTH=true

# --- CORS / allowed origins --------------------------------------------------

# Replace with real deployed dashboard/API origins only.

# Example: https://dashboard.example.com,https://api.example.com

S43_ALLOWED_ORIGINS=CHANGE_ME_PRODUCTION_ORIGINS

# --- SpartaCore integrity watchdog -------------------------------------------

# Required if S43_SPARTA_ENABLED=true.

S43_SPARTA_ENABLED=false
S43_SPARTA_TOKEN_SECRET=CHANGE_ME_GENERATE_TOKEN_URLSAFE_32
S43_SPARTA_NODE_TOKEN=CHANGE_ME_GENERATE_TOKEN_URLSAFE_32

# --- Feature flags -----------------------------------------------------------

# Public beta should keep test injection disabled.

S43_ENABLE_TEST_INJECTION=false

# Enable only after each subsystem passes beta readiness review.

S43_GOVERNANCE_ENABLED=false
S43_FENRIR_ENABLED=false
S43_JORM_ENABLED=false
